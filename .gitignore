# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# .NET / Visual Studio
.vs/
bin/
obj/
*.user
*.userprefs
*.suo

# Obsidian (si abres el repo como boveda, su config es local)
.obsidian/

# Godot importa cualquier imagen del proyecto; las referencias no son assets
docs/references/*.import

# Cache de Python de las herramientas
__pycache__/
*.pyc
